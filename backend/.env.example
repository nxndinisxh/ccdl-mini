# AWS Cloud Integration Environment Variables
# Populate these with the outputs from running `terraform apply`

AWS_REGION=us-east-1
S3_BUCKET_NAME=market-regime-data-XXXXXX
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/XXXXXXXXXXXX/market-regime-risk-engine-ingestion-queue
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:XXXXXXXXXXXX:market-regime-risk-engine-regime-alerts
DYNAMODB_TABLE_NAME=MarketRegimes
